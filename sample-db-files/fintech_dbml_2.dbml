Ref: transactions.id < settlement_items.transaction_id
Ref: users.id < invoices.user_id
Ref: merchants.id < invoices.merchant_id
Ref: currencies.id < invoices.currency_id
Ref: invoices.id < invoice_items.invoice_id
Ref: users.id < subscriptions.user_id
Ref: merchants.id < subscriptions.merchant_id
Ref: currencies.id < subscriptions.currency_id
Ref: subscriptions.id < subscription_events.subscription_id
Ref: currencies.id < subscription_events.currency_id
Ref: users.id < loans.user_id
Ref: currencies.id < loans.currency_id
Ref: loans.id < loan_applications.loan_id
