Ref: currencies.id < card_transactions.currency_id
Ref: merchants.id < merchant_accounts.merchant_id
Ref: accounts.id < merchant_accounts.account_id
Ref: currencies.id < merchant_accounts.settlement_currency_id
Ref: users.id < beneficiaries.user_id
Ref: users.id < transfers.user_id
Ref: accounts.id < transfers.source_account_id
Ref: beneficiaries.id < transfers.beneficiary_id
Ref: currencies.id < transfers.currency_id
Ref: transfers.id < transfer_routes.transfer_id
Ref: accounts.id < transactions.account_id
Ref: users.id < transactions.user_id
Ref: merchants.id < transactions.merchant_id
Ref: currencies.id < transactions.currency_id
